# cp .env.example .env; edit paths, then: set -a; source .env; set +a
# .env is not read automatically. Defaults live in proxy_tasks/common/paths.py.
# This server uses copies on /data; original experiment data are preserved.
# See docs/DATA_INVENTORY.md for per-task contents and verification.
PROXY_DATA_ROOT=/data/proxy-task-bench/data

# Empty values use <repo>/artifacts and <repo>/third_party.
PROXY_OUTPUT_ROOT=
PROXY_VENDOR_ROOT=

# validation uses each task's protocol runtime unless --python is explicit.
# mqar/mad_tsc: /data/envs/hexa-mad/bin/python (torch 2.2.2).
# Other tasks: current Python (requires torch 2.5.1 and CUDA).
