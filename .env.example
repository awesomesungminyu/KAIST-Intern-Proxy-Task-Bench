# proxy-task-bench 경로 설정 예시. 이 서버(kcvl, /workspace) 기준 값이다.
# 다른 환경에서는 반드시 자기 경로로 바꿀 것. 규칙은 proxy_tasks/common/paths.py.
#
# 사용:  cp .env.example .env  →  값 수정  →  set -a; source .env; set +a
# (.env 를 자동으로 읽는 코드는 없다. 셸에 export 해야 적용된다.)

# 태스크별 입력 데이터. 이 디렉터리 아래에 <task>/ 가 있어야 한다.
#   g2p/   vocab.json, train.tsv, val.tsv, test.tsv
#   zinc/  metadata.json, subset/processed/{train,val,test}.pt
#   fflm/  dense.npy, id.npy, sparse.npy, manifest.json
# 이 서버의 실제 데이터는 /workspace/AI4Science_2026summer_archive/smyu/proxy_tasks/<task>/data/
# 에 있다. 구조가 <task>/data/ 라서 그 경로를 직접 넣으면 찾지 못한다.
# README "첫 실행" 의 링크 명령으로 아래 디렉터리를 먼저 만든다.
PROXY_DATA_ROOT=/workspace/proxy-task-bench/data

# 체크포인트·history·로그. 비워 두면 <repo>/artifacts.
PROXY_OUTPUT_ROOT=

# 외부 저장소·패키지 (tfl/, fflm_vendor/). 비워 두면 <repo>/third_party.
PROXY_VENDOR_ROOT=
