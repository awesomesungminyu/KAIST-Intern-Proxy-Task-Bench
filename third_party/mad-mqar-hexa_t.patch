+def _rotate_half(x, interleaved):
+    if interleaved:
+        even = x[..., 0::2]
+        odd = x[..., 1::2]
+        return torch.stack((-odd, even), dim=-1).flatten(-2)
+
+    first, second = x.chunk(2, dim=-1)
+    return torch.cat((-second, first), dim=-1)
+
+
+def _apply_rotary(
+    tensor,
+    rotary_dim,
+    base,
+    interleaved,
+):
+    if rotary_dim <= 0:
+        return tensor
+
+    if rotary_dim % 2:
+        raise ValueError("rotary_emb_dim must be even")
+
+    length = tensor.size(-2)
+    device = tensor.device
+
+    frequencies = 1.0 / (
+        base
+        ** (
+            torch.arange(
+                0,
+                rotary_dim,
+                2,
+                device=device,
+                dtype=torch.float32,
+            )
+            / rotary_dim
+        )
+    )
+    positions = torch.arange(
+        length,
+        device=device,
+        dtype=torch.float32,
+    )
+    angles = torch.outer(positions, frequencies)
+
+    if interleaved:
+        angles = torch.repeat_interleave(angles, 2, dim=-1)
+    else:
+        angles = torch.cat((angles, angles), dim=-1)
+
+    cos = angles.cos().to(dtype=tensor.dtype)[None, None, :, :]
+    sin = angles.sin().to(dtype=tensor.dtype)[None, None, :, :]
+
+    rotated = tensor[..., :rotary_dim]
+    remainder = tensor[..., rotary_dim:]
+
+    rotated = (
+        rotated * cos
+        + _rotate_half(rotated, interleaved) * sin
+    )
+    return torch.cat((rotated, remainder), dim=-1)
+
+
