# 데이터 — setup.sh 로 복원하므로 커밋하지 않는다
/data/
# 경로 이전(common/paths.py) 전 사본 보호용. 당분간 유지한다.
proxy_tasks/*/data/
*.pickle
*.zip
*.tar.gz

# 체크포인트 — 용량이 커서 제외 (필요하면 GitHub Release)
*.pt
*.pth
*.ckpt

# 실행 산출물 — results/ 의 history.json 만 커밋한다
proxy_tasks/runs/
proxy_tasks/logs/
*.log

# 비밀정보
.env
.env.*
!.env.example

# 파이썬
__pycache__/
*.py[cod]
.venv/

# 외부 저장소·패키지 — setup.sh 와 restore_fflm_assets.py 가 받는다
third_party/tfl/
third_party/fflm_vendor/

# Validation artifacts and restored FFLM dependencies stay outside source control.
artifacts/
/artifacts/
proxy_tasks/fflm/vendor/
proxy_tasks/fflm/smoke_runs/
proxy_tasks/fflm/benchmark_runs/
proxy_tasks/fflm/runs/
