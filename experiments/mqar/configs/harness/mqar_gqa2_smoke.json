{
  "version": 1,
  "experiment": "mqar-gqa2-smoke",
  "task": "mqar",
  "requires_gpu": true,
  "max_gpu_utilization_percent": 10,
  "max_gpu_memory_mib": 1024,
  "jobs": [
    {
      "name": "gqa2-smoke",
      "architecture": "GQA-2 Transformer",
      "seed": 456,
      "command": [
        "python3",
        "train_mqar_gqa.py"
      ],
      "env": {
        "HARNESS_SEED": "456",
        "HARNESS_SEQUENCE_LENGTH": "64",
        "HARNESS_NUM_KV_PAIRS": "8",
        "HARNESS_TRAIN_EXAMPLES": "512",
        "HARNESS_VALID_EXAMPLES": "256",
        "HARNESS_BATCH_SIZE": "64",
        "HARNESS_MAX_EPOCHS": "1",
        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    }
  ]
}
