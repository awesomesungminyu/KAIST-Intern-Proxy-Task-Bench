        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    },
    {
      "name": "linear-seed789",
      "architecture": "Linear attention",
      "seed": 789,
      "command": [
        "python3",
        "train_mqar_linear_attention.py"
      ],
      "env": {
        "HARNESS_SEED": "789",
        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    },
    {
      "name": "linear-seed101112",
      "architecture": "Linear attention",
