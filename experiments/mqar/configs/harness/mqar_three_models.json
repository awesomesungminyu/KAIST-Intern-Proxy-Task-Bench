{
  "version": 1,
  "experiment": "mqar-three-models-three-seeds",
  "task": "mqar",
  "requires_gpu": true,
  "max_gpu_utilization_percent": 10,
  "max_gpu_memory_mib": 1024,
  "jobs": [
    {
      "name": "transformer-seed456",
      "architecture": "Transformer",
      "seed": 456,
      "command": [
        "python3",
        "train_mqar_baseline.py"
      ],
      "env": {
        "HARNESS_SEED": "456",
        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    },
    {
      "name": "transformer-seed789",
      "architecture": "Transformer",
      "seed": 789,
      "command": [
        "python3",
        "train_mqar_baseline.py"
      ],
      "env": {
        "HARNESS_SEED": "789",
        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    },
    {
      "name": "transformer-seed101112",
      "architecture": "Transformer",
      "seed": 101112,
      "command": [
        "python3",
        "train_mqar_baseline.py"
      ],
      "env": {
        "HARNESS_SEED": "101112",
        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    },
    {
      "name": "linear-seed456",
      "architecture": "Linear attention",
      "seed": 456,
      "command": [
        "python3",
