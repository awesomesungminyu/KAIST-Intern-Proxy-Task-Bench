      "env": {
        "HARNESS_SEED": "789",
        "HARNESS_OUTPUT_DIR": "{job_dir}/artifacts"
      }
    },
    {
      "name": "gated-seed101112",
      "architecture": "Gated prototype",
      "seed": 101112,
      "command": [
        "python3",
        "train_mqar_gated_linear_attention.py"
      ],
      "env": {
        "HARNESS_SEED": "101112",
