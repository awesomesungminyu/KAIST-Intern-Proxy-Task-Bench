{
  "version": 1,
  "experiment": "mqar-gqa2-seed456-epoch60",
  "task": "mqar",
  "requires_gpu": true,
  "max_gpu_utilization_percent": 10,
  "max_gpu_memory_mib": 1024,
  "jobs": [
    {
      "name": "gqa2-seed456-epoch60",
      "architecture": "GQA-2 Transformer",
      "seed": 456,
      "command": [
        "python3",
        "train_mqar_gqa.py"
      ],
      "env": {
        "HARNESS_SEED": "456",
        "HARNESS_OUTPUT_DIR": "{root}/results/harness_diagnostics/gqa2/seed_456_epoch60",
        "HARNESS_MAX_EPOCHS": "60"
      }
    }
  ]
}
